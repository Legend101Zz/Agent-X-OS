# Agent-X-OS — Phase 1 environment template.
# Copy to `.env` and paste real values. `.env` is gitignored; NEVER commit real secrets.
# The typed loader is agentx_contracts.config.Settings (pydantic-settings). Secrets use SecretStr.

# --- Database: heap / journal / projections (kernel) ----------------------------------
MONGODB_URI=                 # MongoDB Atlas connection string, e.g. mongodb+srv://USER:PASS@cluster/.  SECRET.
MONGODB_DB_NAME=agentx       # Logical database name for Phase 1. (non-secret)

# --- Faculties: the Hermes harness drives Minimax DIRECTLY (your Minimax API key) -----
MINIMAX_API_KEY=                 # your Minimax API key.  SECRET.
FACULTY_MODEL_BASE_URL=          # Minimax OpenAI-compatible endpoint, e.g. https://api.minimax.io/v1  (confirm)
FACULTY_MODEL_ID=                # e.g. MiniMax-M2   (non-secret)
HERMES_ENDPOINT=                 # OPTIONAL: how the kernel reaches Hermes if a service; build agent confirms.

# --- promptfoo JUDGE: via OpenRouter (one key, any model) — a DIFFERENT model than faculties ---
OPENROUTER_API_KEY=              # your OpenRouter key (only needed for the judge).  SECRET.
JUDGE_MODEL_ID=                  # OpenRouter slug, e.g. anthropic/claude-sonnet-4   (non-secret)

# --- Optional: direct GLM/Zhipu key (only if you swap the faculty model off Minimax) --
ZHIPU_API_KEY=                   # optional.  SECRET.

# --- Research provider for lead_research_batch / read_url (Codex lane) — set AT LEAST ONE ---
EXA_API_KEY=                 # Exa search API key (exa-py).        SECRET.  (or use Firecrawl below)
FIRECRAWL_API_KEY=           # Firecrawl scrape/crawl API key (firecrawl-py).  SECRET.

# --- Eval / judge / gate: promptfoo runs as a subprocess (Codex lane) -----------------
PROMPTFOO_API_KEY=           # OPTIONAL: promptfoo Cloud (sharing/teams). SECRET. The judge MODEL itself
                             # uses JUDGE_MODEL_* above; this key is only for promptfoo's hosted features.

# --- Runtime ---------------------------------------------------------------------------
AGENTX_ENV=dev               # dev | test | prod  (non-secret)
